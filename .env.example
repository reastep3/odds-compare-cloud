# Copy this file to `.env` and fill in real values.
# The .env file is gitignored and should never be committed.

# ── The Odds API (primary data source) ───────────────────────────────
ODDS_API_KEY=your_the_odds_api_key_here

# ── Telegram bot ─────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# ── Pinnacle guest API (still used for props + fair-line anchoring) ──
# Rotates occasionally. Get a fresh key from pinnacle.com DevTools →
# Network → any request to guest.api.arcadia.pinnacle.com → X-Api-Key.
PINNACLE_GUEST_KEY=

# ── Action Network scraper headers (JSON blob) ───────────────────────
# Only needed if AN scraper is still in use. Leave blank to skip.
# Example: SCRAPER_HEADERS={"User-Agent":"...","Cookie":"..."}
SCRAPER_HEADERS=

# ── Output location for generated Excel files ────────────────────────
OUTPUT_DIR=./output

# ── Default bankrolls (replace tkinter prompts; override via Telegram) ─
DEFAULT_DK_BANKROLL=100
DEFAULT_FD_BANKROLL=100
